{
  "name": "background-agents-workshop",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/check-ports.mjs 3001 5173 8288",
    "dev": "concurrently --kill-others-on-fail -n operator,web,inngest -c cyan,magenta,yellow \"npm:dev:operator\" \"node scripts/wait-for.mjs http://127.0.0.1:3001/api/health && npm run dev:web\" \"npm:dev:inngest\"",
    "predev:checkout": "node scripts/check-ports.mjs 3004",
    "dev:checkout": "tsx service/checkout.ts",
    "predev:operator": "node scripts/check-ports.mjs 3001",
    "dev:operator": "INNGEST_DEV=1 tsx watch server/operator.ts",
    "predev:agent": "node scripts/check-ports.mjs 3002",
    "dev:agent": "INNGEST_DEV=1 tsx watch server/agent.ts",
    "predev:web": "node scripts/check-ports.mjs 5173",
    "dev:web": "vite --host 127.0.0.1",
    "predev:inngest": "node scripts/check-ports.mjs 8288",
    "dev:inngest": "inngest dev -u http://127.0.0.1:3002/api/inngest",
    "predocs": "node scripts/check-ports.mjs 5174",
    "docs": "vitepress dev lessons --port 5174 --host 127.0.0.1",
    "stop": "node scripts/stop.mjs",
    "docs:build": "vitepress build lessons",
    "notes:generate": "node scripts/build-notes.mjs",
    "notes:check": "node scripts/build-notes.mjs --check",
    "lint": "oxlint server service shared web/src scripts vite.config.ts drizzle.config.ts",
    "format": "oxfmt server service shared web/src scripts/*.mjs vite.config.ts drizzle.config.ts",
    "format:check": "oxfmt --check server service shared web/src scripts/*.mjs vite.config.ts drizzle.config.ts",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx server/seed.ts",
    "preflight": "node scripts/preflight.mjs",
    "typecheck": "tsc --noEmit",
    "build": "vite build"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.78",
    "ai": "7.0.118",
    "dotenv": "^18.0.4",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "inngest": "^4.21.0",
    "lucide-react": "^1.48.0",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.11",
    "inngest-cli": "^1.45.1",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitepress": "^1.6.4"
  }
}
